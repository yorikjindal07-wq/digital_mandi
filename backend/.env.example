HUGGING_FACE_API_KEY=your_hugging_face_key_here
HUGGING_FACE_MODEL=katanemo/Arch-Router-1.5B:hf-inference
HUGGING_FACE_API_URL=https://router.huggingface.co/v1/chat/completions
OPENWEATHER_API_KEY=your_openweather_key_here
CORS_ALLOW_ORIGINS=https://your-web-app.example.com

# JWT auth for mobile users
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_REFRESH_SECRET_KEY=replace_with_a_different_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# Admin-only manual operations
ADMIN_API_TOKEN=replace_with_a_long_random_secret

# Optional legacy shared app token. Keep empty if you fully move to JWT auth.
BACKEND_API_TOKEN=

# Abuse protection
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=30

# Production on Render: prefer DATABASE_URL from Render Postgres.
# Example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/digital_mandi
#
# Local/default fallback:
SQLITE_PATH=./data/digital_mandi.db
